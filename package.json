{
  "name": "@ipscope/sdk-node",
  "version": "1.0.0",
  "description": "Official, zero-dependency, type-safe Node.js server-side SDK for IPScope IP Intelligence lookups.",
  "license": "MIT",
  "homepage": "https://ipscope.io/docs/sdks/node",
  "repository": {
    "type": "git",
    "url": "https://github.com/ipscope-io/ipscope-node.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
